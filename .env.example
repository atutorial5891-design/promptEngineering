# Copy to .env and fill in only the providers you use. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Default model for labs: any LiteLLM model string ("provider/model-name").
# Pick a current small/cheap model from your provider's model list, or a local one via Ollama.
# Examples of the format: openai/gpt-5-mini, anthropic/claude-sonnet-4-5, gemini/gemini-2.5-flash, ollama/llama3.1
PEM_MODEL=openai/gpt-5-mini
# Model used as the LLM-as-judge in evals (ideally stronger than PEM_MODEL)
PEM_JUDGE_MODEL=openai/gpt-5-mini
